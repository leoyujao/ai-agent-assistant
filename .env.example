# DeepSeek API 配置（公司网关 Anthropic 兼容接口）
ANTHROPIC_BASE_URL=http://your-api-gateway:4000
ANTHROPIC_AUTH_TOKEN=your_auth_token_here
ANTHROPIC_MODEL=deepseek-flash

# 评估判分模型（仅 eval_scoring.py 使用）
# 留空则用 ANTHROPIC_MODEL 自己评自己，LLM-as-Judge 会偏向自己的输出、分数偏高。
# 建议填一个与被测模型不同的模型。
ANTHROPIC_JUDGE_MODEL=

# 服务监听地址
# 默认只绑本机：后端没有鉴权，改成 0.0.0.0 会让同网段任何人都能调用并消耗你的 API Key
HOST=127.0.0.1
PORT=8000

# HuggingFace 镜像（国内访问加速）
HF_ENDPOINT=https://hf-mirror.com

# LangSmith 可观测性追踪（注意：开启后提问内容与文档片段会上报到 LangSmith）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=my-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
